meta {
  name: Fetch the employee we just added
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/employees/{{newEmployeeId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

tests {
  test("the person created by the previous request is readable", function() {
    expect(res.getBody().name).to.equal("Bruno Tester");
    expect(res.getBody().location).to.equal("Pune");
  });

  test("the level survived the round trip as an integer", function() {
    expect(res.getBody().skills).to.eql([{ skill: "SQL", level: 3 }]);
  });
}

docs {
  `{{newEmployeeId}}` was captured from the previous response — see its **Vars** tab, which
  holds `newEmployeeId: res.body.employee_id`. That is the chaining pattern for any
  create-then-read flow, and it keeps this request working no matter how many times the
  collection has been run against the same server.
}
