# Copy to .env and edit. A real environment variable beats this file, so you can
# override any one setting for a single run:
#   MODEL_PROVIDER=bedrock uv run app/runtimes/talent_screening/main.py

# --- which half of the world -------------------------------------------------
# Leave false on your laptop. Terraform sets it to true inside every Runtime
# container; it is what makes each entrypoint bind the port AgentCore expects.
AGENTCORE=false

# --- the model ---------------------------------------------------------------
MODEL_PROVIDER=ollama

# Local. Nothing leaves the machine, no API keys.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Bedrock. No default is shipped because model ids are account- and
# region-specific. List the ones you can actually call:
#   aws bedrock list-foundation-models --region us-west-2 --query 'modelSummaries[].modelId'
#
# Anthropic models need a one-off use-case form approved per account; until it is,
# every call fails with "Model use case details have not been submitted for this
# account". Amazon's Nova models have no such gate, so the terraform examples use:
#   us.amazon.nova-lite-v1:0     small, cheap
#   us.amazon.nova-pro-v1:0      when Lite starts wandering across five agents
BEDROCK_MODEL_ID=
AWS_REGION=us-west-2

# --- the data ----------------------------------------------------------------
# local = the dataset in app/_shared/hr_data.py
# s3    = the same records, read from the bucket below
DATA_SOURCE=local
S3_BUCKET=

# --- filled in from terraform outputs once deployed --------------------------
GATEWAY_URL=
SKILLS_MCP_ARN=
SCREENING_ARN=
OUTREACH_ARN=
COMPLIANCE_ARN=
MEMORY_ID=
